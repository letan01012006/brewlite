PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite"
TEST_DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite_test"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
OTP_HASH_SECRET="replace-with-a-separate-random-secret-at-least-32-characters"
AUTH_OTP_DEMO=false
AUTH_DEMO_SEED=false

# eSMS real SMS: never commit the real keys from your eSMS account.
SMS_PROVIDER=esms
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
# Baotrixemay is only usable when enabled for your eSMS account.
# Keep the approved text unchanged; only {OTP} is replaced with a random code.
ESMS_BRANDNAME="Baotrixemay"
ESMS_OTP_TEMPLATE="{OTP} la ma xac minh dang ky Baotrixemay cua ban"
ESMS_TIMEOUT_MS=10000
# SmsType="2" and Sandbox="0" are fixed by the adapter (real, billable SMS).
# Offline development only: SMS_PROVIDER=local, AUTH_OTP_DEMO=true.
# Local mode never logs OTPs; eSMS always uses random six-digit codes.

# VNPAY Sandbox Configuration
VNPAY_TMN_CODE="SANDBOX_TMN_CODE"
VNPAY_HASH_SECRET="SANDBOX_HASH_SECRET"
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNPAY_RETURN_URL="http://localhost:3000/payment/vnpay-return"
PAYMENT_EXPIRE_MINUTES=15
# Unpaid order lifetime; active/unknown payments must reconcile before release.
ORDER_PENDING_EXPIRE_MINUTES=15
PAYMENT_MOCK_ENABLED=true
TRUST_PROXY=false
